.env
.env.local
web/.env.local

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/

# Node / Next
web/node_modules/
web/.next/
web/out/
web/tsconfig.tsbuildinfo
web/next_dev.log

# Runtime / local data (do not commit)
.runtime/
runtime/
.rag_index/
*.db
*.db-wal
*.db-shm
dump.rdb
web/dump.rdb
pipeline.log
luma_brain.db

# Local studio ingest config (machine-specific paths); commit studio_ingest.example.json instead
configs/studio_ingest.json

# Stray pipeline eval outputs
evaluation_*.json

# Quality platform local run artifacts (schemas/contracts stay tracked)
quality/store/

# General-agent artifact workspace (per-session deliverables; local-only)
data/agent_workspace/

# Weekly agent review-queue exports (may contain user chat text); keep .gitkeep
data/review_queue/*.jsonl

# OS / IDE
.DS_Store
.idea/
*.swp

# Data layout: data/raw is local-only; data/eval (labels) and data/fixtures (small samples) are tracked
data/raw/
data/eval/images/
data/eval/images_*/
data/eval/irr_*/
data/eval/_*/
data/eval/*.log
data/eval/archive_golden_core/
data/eval/relabel/
data/eval/candidate_rounds/*/gallery_assets/
data/eval/candidate_rounds/*/relabel_images/
data/eval/candidate_rounds/*/oriented_images/
data/eval/selection_v1/images/
data/eval/selection_v1/gallery_assets/
data/eval/selection_v1/normalized_images/
models/eval/
*.ARW

# Pipeline render outputs / scratch images at repo root (curated demos live in docs/images, web/public)
outputs/
/*.jpg
/*.jpeg
/*.png

# Compiled Go binaries
/ingest_worker
/arw_extractor

# Backups (e.g. luma_brain.db.bak-YYYYMMDD-HHMMSS) — never commit; *.db alone misses .db.bak
*.bak
*.db.bak*

# Real-people photos moved out of repo for privacy (originals kept locally outside the repo).
# Re-add intentionally with `git add -f` only after confirming consent / portrait rights.
data/agent_demo/*.jpg
demo_gallery/**/*.jpg
docs/images/*.jpg
web/public/showcase/**/*.jpg
# Per-session heroes for Vercel /studio (EXIF-stripped; built by build_session_covers.py)
!web/public/showcase/covers/
!web/public/showcase/covers/**
# Fixed landing first-screen background (EXIF-stripped); referenced by LANDING_HERO.backgroundSrc
!web/public/showcase/landing-hero.jpg
# Scripted Agent demo keepers from 2026-04-16 (EXIF-stripped)
!web/public/showcase/agent-demo/
!web/public/showcase/agent-demo/**
# Local cover catalog with absolute paths — commit only the .example.json
data/bench/session_covers_sources.json

# Markdown docs (currently messy; excluded from VCS. Use `git add -f <file>.md` to track specific ones)
*.md
!data/knowledge/platform_xiaohongshu.md
!data/knowledge/platform_instagram.md
!data/knowledge/studio_selection_sop.md
!data/knowledge/livehouse_aesthetic_standard.md
!data/knowledge/copyright_portrait_guideline.md

# Private interview / resume notes — keep local only, never commit
docs/interview_*
docs/private/
docs/agent_capability_map.md
