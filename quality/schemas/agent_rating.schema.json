{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livehouse.local/quality/schemas/agent_rating.schema.json",
  "title": "Agent Rating v1",
  "description": "One human or LLM-judge rubric row for a Gallery Copilot turn (useful/honest/concise, 1–5).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "case_id",
    "utterance",
    "reply",
    "scores",
    "rater"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent_rating.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "description": "Matches agent_chat_case.id when rating a fixture turn."
    },
    "utterance": { "type": "string" },
    "reply": { "type": "string" },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": { "type": ["string", "null"] },
          "ok": { "type": ["boolean", "null"] },
          "metadata": { "type": "object" }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useful", "honest", "concise"],
      "properties": {
        "useful": { "type": "integer", "minimum": 1, "maximum": 5 },
        "honest": { "type": "integer", "minimum": 1, "maximum": 5 },
        "concise": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "raw_scores": {
      "type": "object",
      "description": "Pre-groundedness-gate scores from the judge."
    },
    "mean": { "type": "number" },
    "grounded_ok": { "type": "boolean" },
    "pass": { "type": "boolean" },
    "gated": { "type": "boolean" },
    "rationale": { "type": "string" },
    "notes": { "type": "string" },
    "rater": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. human | llm_judge | llm_judge_mock"
    },
    "detail": { "type": "object" }
  }
}
